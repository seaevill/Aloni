{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude/check.sh\" branch",
            "timeout": 120
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude/check.sh\" edited",
            "timeout": 120
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude/check.sh\" language",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
