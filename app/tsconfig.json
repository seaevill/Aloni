{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true, "resolveJsonModule": true,
    "jsx": "react-jsx", "jsxImportSource": "preact", "isolatedModules": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["tests/fixtures/lint"]
}
